# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://reservite:reservite@localhost:5432/reservite?schema=public"

# --- Authentification ---
# Générez un vrai secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changez-moi-avec-une-vraie-valeur-secrete-longue"
JWT_ACCESS_EXPIRES_IN="1h"
REFRESH_TOKEN_DAYS=30

# --- Serveur ---
PORT=4000
# Origines autorisées (séparées par des virgules). En production : adresses réelles du web.
CORS_ORIGIN="http://localhost:3000"

# --- Règles métier ---
SERVICE_FEE_RATE=0.05
CANCEL_LIMIT_HOURS=2
SEAT_HOLD_MINUTES=15

# --- Paiement ---
# simulated = paiement accepté immédiatement (développement) ; cinetpay = vrai paiement
PAYMENT_PROVIDER="simulated"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
# Adresse publique de cette API (CinetPay y envoie le webhook) et page de retour du client
PUBLIC_API_URL="http://localhost:4000"
PAYMENT_RETURN_URL="http://localhost:3000/paiement/retour"

# --- SMS / e-mail (simulés tant que non renseignés : écrits dans les journaux) ---
SMS_PROVIDER="log"
EMAIL_PROVIDER="log"

# --- Stockage de fichiers compatible S3 (AWS S3, Cloudflare R2, Scaleway...) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Données de démonstration (jamais en production) ---
SEED_DEMO="true"
