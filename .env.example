# Base de données — SQLite pour commencer (aucune configuration requise).
# Pour la production, remplacez par une URL PostgreSQL :
# DATABASE_URL="postgresql://user:password@host:5432/reservite"
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les jetons de connexion (JWT).
# Générez-en un vrai avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changez-moi-avec-une-vraie-valeur-secrete-longue"

# Durée de validité d'une session avant reconnexion obligatoire
JWT_EXPIRES_IN="30d"

# Port d'écoute du serveur
PORT=4000

# Autorise le frontend (backoffice web + app mobile) à appeler cette API.
# Mettez l'URL réelle de votre frontend en production (ex: https://backoffice.reservite.ci)
CORS_ORIGIN="*"

# --- Paiement (CinetPay) ---
# Créez un compte marchand sur https://cinetpay.com pour obtenir ces valeurs.
# Tant qu'elles ne sont pas renseignées, les paiements restent simulés (voir src/payments/cinetpay.js).
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
